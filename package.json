  "main": "./src/chart.js",
  "exports": {
    ".": "./src/chart.js",
    "./core": "./src/core.js",
    "./axis": "./src/axis.js",
    "./mosaic": "./src/mosaic.js",
    "./pie": "./src/pie.js",
    "./bar": "./src/bar.js",
    "./line": "./src/line.js",
    "./heatmap": "./src/heatmap.js",
    "./gauge": "./src/gauge.js",
    "./histogram": "./src/histogram.js",
    "./candle": "./src/candle.js",
    "./waterfall": "./src/waterfall.js",
    "./table": "./src/table.js",
    "./radar": "./src/radar.js",
    "./treemap": "./src/treemap.js",
    "./sankey": "./src/sankey.js",
    "./kanban": "./src/kanban.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "accuracy": "node scripts/accuracy.mjs",
