{
  "name": "opencode-charts",
  "version": "0.1.0",
  "type": "module",
  "description": "Terminal chart rendering for the OpenCode TUI: 23 families from a JSON fence, dependency-free ES modules",
  "main": "./index.js",
  "exports": {
    "./tui": "./tui.js",
    ".": "./index.js",
    "./core": "./src/core.js",
    "./axis": "./src/axis.js",
    "./mosaic": "./src/mosaic.js",
    "./pie": "./src/pie.js",
    "./bar": "./src/bar.js",
    "./line": "./src/line.js",
    "./heatmap": "./src/heatmap.js",
    "./gauge": "./src/gauge.js",
    "./histogram": "./src/histogram.js",
    "./candle": "./src/candle.js",
    "./waterfall": "./src/waterfall.js",
    "./table": "./src/table.js",
    "./radar": "./src/radar.js",
    "./treemap": "./src/treemap.js",
    "./sankey": "./src/sankey.js",
    "./kanban": "./src/kanban.js",
    "./gantt": "./src/gantt.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "accuracy": "node scripts/accuracy.mjs",
    "demo": "node scripts/demo.mjs",
    "variants": "node scripts/variants.mjs"
  },
  "files": [
    "index.js",
    "tui.js",
    "src/"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.5.17"
  },
  "engines": {
    "node": ">=22"
  }
}
