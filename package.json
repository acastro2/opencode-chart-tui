{
  "name": "opencode-charts",
  "version": "0.3.0",
  "type": "module",
  "description": "Terminal chart rendering for the OpenCode TUI: 30 families from a JSON fence, dependency-free ES modules",
  "main": "./index.js",
  "exports": {
    "./tui": "./tui.js",
    ".": "./index.js",
    "./core": "./src/core.js",
    "./axis": "./src/axis.js",
    "./mosaic": "./src/mosaic.js",
    "./pie": "./src/pie.js",
    "./bar": "./src/bar.js",
    "./line": "./src/line.js",
    "./heatmap": "./src/heatmap.js",
    "./gauge": "./src/gauge.js",
    "./histogram": "./src/histogram.js",
    "./candle": "./src/candle.js",
    "./ohlc": "./src/ohlc.js",
    "./text": "./src/text.js",
    "./layout": "./src/layout.js",
    "./waterfall": "./src/waterfall.js",
    "./table": "./src/table.js",
    "./radar": "./src/radar.js",
    "./treemap": "./src/treemap.js",
    "./sankey": "./src/sankey.js",
    "./kanban": "./src/kanban.js",
    "./gantt": "./src/gantt.js",
    "./box": "./src/box.js",
    "./funnel": "./src/funnel.js",
    "./calendar": "./src/calendar.js",
    "./bullet": "./src/bullet.js",
    "./slope": "./src/slope.js",
    "./dot": "./src/dot.js",
    "./combo": "./src/combo.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "accuracy": "node scripts/accuracy.mjs",
    "audit": "node scripts/audit.mjs",
    "fidelity": "node scripts/fidelity.mjs",
    "golden": "node scripts/golden.mjs --check",
    "golden:update": "node scripts/golden.mjs --update",
    "perf": "node scripts/perf.mjs",
    "probe:tui": "node scripts/probe.mjs",
    "gallery": "node scripts/gallery.mjs",
    "gallery:light": "node scripts/images.mjs 76 --theme light && node scripts/gallery.mjs --theme light",
    "demo": "node scripts/demo.mjs",
    "variants": "node scripts/variants.mjs",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "files": [
    "index.js",
    "tui.js",
    "src/",
    "skills/",
    "schema/"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.5.17"
  },
  "engines": {
    "node": ">=22"
  }
}
